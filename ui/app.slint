import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";

import { Theme } from "theme.slint";
import { TitleBar } from "title-bar.slint";
import { PathField } from "path-field.slint";
import { ComparisonCard, TreeRow, RowStatus, NameSort } from "comparison.slint";
import { BuildSummary, SummaryView } from "summary.slint";

export { TreeRow, RowStatus, NameSort, SummaryView }

export enum ResizeEdge { north, south, east, west, north-east, north-west, south-east, south-west }

component BuildButton inherits Rectangle {
    in property <bool> enabled;
    // While a Build runs the button turns into its progress bar.
    in property <bool> building;
    in property <float> progress;
    callback clicked();

    height: 45px;
    border-radius: 8px;
    clip: true;
    background: root.building ? Theme.accent
        : !root.enabled ? Theme.accent-disabled
        : touch.pressed ? Theme.accent-pressed
        : touch.has-hover ? Theme.accent-hover
        : Theme.accent;

    if root.building: Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        background: #FFFFFF2E;
    }

    touch := TouchArea {
        enabled: root.enabled && !root.building;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 12px;

        if !root.building: VerticalLayout {
            alignment: center;
            Image {
                width: 20px;
                height: 20px;
                source: @image-url("icons/play.svg");
                colorize: #FFFFFF;
            }
        }

        Text {
            text: root.building ? "Building… \{Math.floor(root.progress * 100)}%" : "Build";
            font-size: 15px;
            font-weight: 600;
            color: #FFFFFF;
            vertical-alignment: center;
        }
    }
}

// Secondary action next to Build; while a Scan runs it turns into the Scan's progress bar.
component RescanButton inherits Rectangle {
    in property <bool> enabled;
    in property <bool> scanning;
    in property <float> progress;
    callback clicked();

    height: 45px;
    border-radius: 8px;
    border-width: 1px;
    clip: true;
    border-color: touch.has-hover ? Theme.field-border-hover : Theme.field-border;
    background: touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.row-hover : Theme.surface;

    if root.scanning: Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        background: Theme.indigo-fill;
    }

    touch := TouchArea {
        enabled: root.enabled && !root.scanning;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 10px;

        if !root.scanning: VerticalLayout {
            alignment: center;
            Image {
                width: 18px;
                height: 18px;
                source: @image-url("icons/refresh.svg");
                colorize: root.enabled ? Theme.accent : Theme.unchanged-dot;
            }
        }

        Text {
            text: root.scanning ? "Scanning… \{Math.floor(root.progress * 100)}%" : "Rescan";
            font-size: 15px;
            font-weight: 600;
            color: root.enabled || root.scanning ? Theme.ink : Theme.unchanged-dot;
            vertical-alignment: center;
        }
    }
}

component ResizeHandle inherits TouchArea {
    in property <ResizeEdge> edge;
    callback start-resize(edge: ResizeEdge);

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.start-resize(root.edge);
        }
    }
}

export component AppWindow inherits Window {
    in property <string> source-path;
    in property <string> update-tree-path;
    in property <[TreeRow]> rows;
    in property <NameSort> sort;
    in property <bool> has-comparison;
    in property <SummaryView> summary;
    in property <bool> building;
    in property <float> build-progress;
    in property <bool> scanning;
    in property <float> scan-progress;
    // The last Scan found something to publish.
    in property <bool> can-build;

    callback pick-source();
    callback pick-update-tree();
    callback build();
    callback rescan();
    callback row-clicked(node: int);
    callback sort-clicked();

    callback start-drag();
    callback start-resize(edge: ResizeEdge);

    title: "Patch Builder";
    icon: @image-url("icons/app-icon.svg");
    no-frame: true;
    // Opening size; Rust reads it to center the window before it is shown.
    out property <length> initial-width: 1280px;
    out property <length> initial-height: 831px;
    preferred-width: self.initial-width;
    preferred-height: self.initial-height;
    min-width: 1040px;
    min-height: 600px;
    // Transparent so the rounded frame below owns the corners, anti-aliased by the renderer.
    background: transparent;
    default-font-family: "Inter";

    // Larger than the 8px DWM rounds the window with, so its un-anti-aliased clip stays outside this curve.
    property <length> corner-radius: root.maximized ? 0 : 10px;

    Rectangle {
        background: Theme.surface;
        border-radius: root.corner-radius;
    }

    VerticalLayout {
        TitleBar {
            corner-radius: root.corner-radius;
            maximized: root.maximized;
            start-drag => { root.start-drag(); }
            minimize => { root.minimized = true; }
            toggle-maximize => { root.maximized = !root.maximized; }
            close => { root.close(); }
        }

        VerticalLayout {
            padding: 21px;
            padding-top: 20px;
            spacing: 27px;

            HorizontalLayout {
                spacing: 21px;

                // Zero preferred widths make the split follow the stretch ratio alone,
                // so picking a longer path never shifts the fields.
                PathField {
                    horizontal-stretch: 460;
                    preferred-width: 0;
                    min-width: 0;
                    enabled: !root.scanning && !root.building;
                    label: "Source";
                    path: root.source-path;
                    placeholder: "Choose the client folder…";
                    pick => { root.pick-source(); }
                }

                PathField {
                    horizontal-stretch: 517;
                    preferred-width: 0;
                    min-width: 0;
                    enabled: !root.scanning && !root.building;
                    label: "Update tree";
                    path: root.update-tree-path;
                    placeholder: "Choose the publish folder…";
                    pick => { root.pick-update-tree(); }
                }

                VerticalLayout {
                    alignment: end;
                    horizontal-stretch: 0;

                    RescanButton {
                        width: 160px;
                        enabled: root.source-path != "" && root.update-tree-path != "" && !root.building;
                        scanning: root.scanning;
                        progress: root.scan-progress;
                        clicked => { root.rescan(); }
                    }
                }

                VerticalLayout {
                    alignment: end;
                    horizontal-stretch: 0;

                    BuildButton {
                        width: 219px;
                        enabled: root.can-build && !root.scanning;
                        building: root.building;
                        progress: root.build-progress;
                        clicked => { root.build(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 21px;
                vertical-stretch: 1;

                ComparisonCard {
                    rows: root.rows;
                    sort: root.sort;
                    has-comparison: root.has-comparison;
                    scanning: root.scanning;
                    row-clicked(node) => { root.row-clicked(node); }
                    sort-clicked => { root.sort-clicked(); }
                }

                BuildSummary {
                    width: 321px;
                    summary: root.summary;
                }
            }
        }
    }

    // Drawn over the content so the header cannot hide it.
    if !root.maximized: Rectangle {
        border-radius: root.corner-radius;
        border-width: 1px;
        border-color: Theme.window-border;
    }

    // Borderless windows resize through these edge strips; hidden while maximized.
    property <length> grip: 5px;
    if !root.maximized: ResizeHandle {
        x: root.grip;
        y: 0;
        width: root.width - 2 * root.grip;
        height: root.grip;
        edge: ResizeEdge.north;
        mouse-cursor: ns-resize;
        start-resize(edge) => { root.start-resize(edge); }
    }
    if !root.maximized: ResizeHandle {
        x: root.grip;
        y: root.height - root.grip;
        width: root.width - 2 * root.grip;
        height: root.grip;
        edge: ResizeEdge.south;
        mouse-cursor: ns-resize;
        start-resize(edge) => { root.start-resize(edge); }
    }
    if !root.maximized: ResizeHandle {
        x: 0;
        y: root.grip;
        width: root.grip;
        height: root.height - 2 * root.grip;
        edge: ResizeEdge.west;
        mouse-cursor: ew-resize;
        start-resize(edge) => { root.start-resize(edge); }
    }
    if !root.maximized: ResizeHandle {
        x: root.width - root.grip;
        y: root.grip;
        width: root.grip;
        height: root.height - 2 * root.grip;
        edge: ResizeEdge.east;
        mouse-cursor: ew-resize;
        start-resize(edge) => { root.start-resize(edge); }
    }
    if !root.maximized: ResizeHandle {
        x: 0;
        y: 0;
        width: root.grip;
        height: root.grip;
        edge: ResizeEdge.north-west;
        mouse-cursor: nwse-resize;
        start-resize(edge) => { root.start-resize(edge); }
    }
    if !root.maximized: ResizeHandle {
        x: root.width - root.grip;
        y: 0;
        width: root.grip;
        height: root.grip;
        edge: ResizeEdge.north-east;
        mouse-cursor: nesw-resize;
        start-resize(edge) => { root.start-resize(edge); }
    }
    if !root.maximized: ResizeHandle {
        x: 0;
        y: root.height - root.grip;
        width: root.grip;
        height: root.grip;
        edge: ResizeEdge.south-west;
        mouse-cursor: nesw-resize;
        start-resize(edge) => { root.start-resize(edge); }
    }
    if !root.maximized: ResizeHandle {
        x: root.width - root.grip;
        y: root.height - root.grip;
        width: root.grip;
        height: root.grip;
        edge: ResizeEdge.south-east;
        mouse-cursor: nwse-resize;
        start-resize(edge) => { root.start-resize(edge); }
    }
}
