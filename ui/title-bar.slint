import { Theme } from "theme.slint";

component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <bool> destructive;
    callback clicked();

    width: 46px;
    height: 32px;
    background: touch.pressed ? (root.destructive ? Theme.close-pressed : Theme.control-pressed)
        : touch.has-hover ? (root.destructive ? Theme.close-hover : Theme.control-hover)
        : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Image {
        width: 12px;
        height: 12px;
        source: root.icon;
        colorize: root.destructive && touch.has-hover ? #FFFFFF : Theme.muted;
    }
}

component ThemeButton inherits Rectangle {
    in property <bool> dark-theme;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 7px;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent;
    background: touch.pressed ? Theme.control-pressed
        : touch.has-hover || focus.has-focus ? Theme.control-hover
        : transparent;
    accessible-role: button;
    accessible-label: root.dark-theme ? "Use light theme" : "Use dark theme";
    accessible-description: root.dark-theme
        ? "Switch Patch Builder to the light theme"
        : "Switch Patch Builder to the dark theme";
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    Image {
        width: 17px;
        height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.dark-theme ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
        colorize: Theme.muted;
        accessible-role: none;
    }
}

export component TitleBar inherits Rectangle {
    in property <bool> maximized;
    in property <bool> dark-theme;
    // Matches the window frame, so the header and the close button's hover stay inside it.
    in property <length> corner-radius;
    callback start-drag();
    callback minimize();
    callback toggle-maximize();
    callback close();
    callback toggle-theme();

    height: 78px;
    background: Theme.header;
    border-top-left-radius: root.corner-radius;
    border-top-right-radius: root.corner-radius;
    clip: true;

    // Dragging starts on the first move after a press so double-clicks still reach the TouchArea;
    // the flag resets before the drag because the OS move loop swallows the release.
    property <bool> drag-armed;
    TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                root.drag-armed = event.kind == PointerEventKind.down;
            }
        }
        moved => {
            if (root.drag-armed) {
                root.drag-armed = false;
                root.start-drag();
            }
        }
        double-clicked => { root.toggle-maximize(); }
    }

    Rectangle {
        x: 25px;
        y: 18px;
        width: 43px;
        height: 43px;
        border-radius: 10px;
        background: Theme.logo;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.logo-shadow;

        Image {
            width: 27px;
            height: 27px;
            source: @image-url("icons/logo-mark.svg");
        }
    }

    Text {
        x: 84px;
        y: 28.8px - self.height / 2;
        text: "Patch Builder";
        font-size: 17.5px;
        font-weight: 600;
        color: Theme.ink;
    }

    Text {
        x: 84px;
        y: 51.2px - self.height / 2;
        text: "File hashing & zipping tool for game updates";
        font-size: 12.25px;
        color: Theme.muted;
    }

    ThemeButton {
        x: parent.width - 40px;
        y: 39px;
        dark-theme: root.dark-theme;
        clicked => { root.toggle-theme(); }
    }

    HorizontalLayout {
        width: 3 * 46px;
        x: parent.width - self.width;
        y: 0;
        height: 32px;

        WindowButton {
            icon: @image-url("icons/window-minimize.svg");
            clicked => { root.minimize(); }
        }

        WindowButton {
            icon: root.maximized ? @image-url("icons/window-restore.svg") : @image-url("icons/window-maximize.svg");
            clicked => { root.toggle-maximize(); }
        }

        WindowButton {
            icon: @image-url("icons/window-close.svg");
            destructive: true;
            clicked => { root.close(); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.header-border;
    }
}
