import { Theme } from "theme.slint";

// Always-visible vertical scrollbar in the app's palette, driving a ListView's `content-y`.
export component ScrollBar inherits Rectangle {
    // Two-way bound to the ListView: 0 at the top, negative once scrolled down.
    in-out property <length> content-y;
    in property <length> content-height;
    in property <length> visible-height;

    property <length> maximum: max(0px, root.content-height - root.visible-height);
    property <length> thumb-height: max(36px, root.height * root.visible-height / max(1px, root.content-height));
    property <length> travel: max(1px, root.height - root.thumb-height);

    width: 8px;
    border-radius: self.width / 2;
    background: Theme.scroll-track;

    thumb := Rectangle {
        y: root.maximum == 0 ? 0 : -root.content-y / root.maximum * root.travel;
        width: parent.width;
        height: root.thumb-height;
        border-radius: self.width / 2;
        background: touch.pressed ? Theme.scroll-thumb-pressed
            : touch.has-hover ? Theme.scroll-thumb-hover
            : Theme.scroll-thumb;
    }

    // Covers the whole track so dragging keeps working when the pointer leaves the thumb.
    touch := TouchArea {
        property <length> pressed-value;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                if (self.mouse-y < thumb.y || self.mouse-y > thumb.y + thumb.height) {
                    // A click on the track centers the thumb under the pointer, then drags from there.
                    root.content-y = -clamp((self.mouse-y - root.thumb-height / 2) * root.maximum / root.travel, 0px, root.maximum);
                }
                self.pressed-value = -root.content-y;
            }
        }
        moved => {
            if (self.pressed) {
                root.content-y = -clamp(self.pressed-value + (self.mouse-y - self.pressed-y) * root.maximum / root.travel, 0px, root.maximum);
            }
        }
    }
}
