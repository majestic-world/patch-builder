// Palette: white and grays, with #333 as the accent (buttons, highlights).
// Only the file status colors (green/amber/slate) step outside this gray scale.
export global Theme {
    // Surfaces
    out property <color> surface: #FFFFFF;
    out property <color> header: #FAFAFA;
    out property <color> field: #FAFAFA;
    out property <color> table-header: #FAFAFA;
    out property <color> summary: #F7F7F8;
    out property <color> border: #E5E5E7;
    out property <color> card-border: #EDEDEF;
    out property <color> field-border: #DFDFE2;
    out property <color> header-border: #EDEDEF;
    out property <color> field-border-hover: #C7C7CB;
    out property <color> guide: #DCDCDF;
    out property <color> row-hover: #F6F6F7;
    out property <color> row-selected: #F0F0F1;
    out property <color> scroll-track: #EFEFF1;
    out property <color> scroll-thumb: #C9C9CD;
    out property <color> scroll-thumb-hover: #ACACB1;
    out property <color> scroll-thumb-pressed: #8E8E94;
    out property <color> window-border: #D9D9DC;
    out property <color> card-shadow: #0000000A;

    // Text and icons
    out property <color> ink: #27272A;
    out property <color> ink-soft: #3A3A3E;
    out property <color> ink-data: #424247;
    out property <color> muted: #6B6B72;
    out property <color> icon: #707077;

    // Accent
    out property <color> accent: #333333;
    out property <color> accent-hover: #444444;
    out property <color> accent-pressed: #222222;
    out property <color> accent-disabled: #C4C4C8;
    out property <color> accent-fill: #EBEBED;
    out property <brush> logo: @linear-gradient(135deg, #4A4A4A 0%, #222222 100%);
    out property <color> logo-shadow: #33333333;

    // File status
    out property <color> new-dot: #1E9E55;
    out property <color> new-text: #18924A;
    out property <color> new-fill: #DEF4E7;
    out property <color> changed-dot: #DF8E10;
    out property <color> changed-text: #C8770A;
    out property <color> changed-fill: #FDF0DC;
    out property <color> unchanged-dot: #A6B0C7;
    out property <color> unchanged-pill-dot: #6B7390;
    out property <color> unchanged-text: #535F80;
    out property <color> unchanged-fill: #ECEEF3;

    // Summary badges
    out property <color> neutral-fill: #EDEDEF;
    out property <color> neutral-icon: #3A3A3E;

    // Window controls
    out property <color> control-hover: #EDEDEF;
    out property <color> control-pressed: #E2E2E5;
    out property <color> close-hover: #3A3A3E;
    out property <color> close-pressed: #27272A;
}
