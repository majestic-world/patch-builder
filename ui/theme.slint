export global Theme {
    // Surfaces
    out property <color> surface: #FFFFFF;
    out property <color> header: #F9F9FC;
    out property <color> field: #FBFBFD;
    out property <color> table-header: #FAFAFC;
    out property <color> summary: #F7F8FD;
    out property <color> border: #E3E8F1;
    out property <color> field-border: #DDE4F0;
    out property <color> header-border: #EDF0F5;
    out property <color> field-border-hover: #C5CEE0;
    out property <color> guide: #D9E1EE;
    out property <color> row-hover: #F7F8FB;
    out property <color> row-selected: #FEF8F0;
    out property <color> scroll-track: #EFF2F7;
    out property <color> scroll-thumb: #C6CEDC;
    out property <color> scroll-thumb-hover: #AAB4C7;
    out property <color> scroll-thumb-pressed: #8F9AB0;

    // Text and icons
    out property <color> ink: #141A33;
    out property <color> ink-soft: #26324C;
    out property <color> ink-data: #2E3B5C;
    out property <color> muted: #5E6C8A;
    out property <color> icon: #66718A;

    // Accent
    out property <color> accent: #5560DA;
    out property <color> accent-hover: #4B56D0;
    out property <color> accent-pressed: #434DC2;
    out property <color> accent-disabled: #B9BEF0;
    out property <brush> logo: @linear-gradient(135deg, #6369EC 0%, #2F35A8 100%);

    // File status
    out property <color> new-dot: #1E9E55;
    out property <color> new-text: #18924A;
    out property <color> new-fill: #DEF4E7;
    out property <color> changed-dot: #DF8E10;
    out property <color> changed-text: #C8770A;
    out property <color> changed-fill: #FDF0DC;
    out property <color> unchanged-dot: #A6B0C7;
    out property <color> unchanged-pill-dot: #6B7390;
    out property <color> unchanged-text: #535F80;
    out property <color> unchanged-fill: #ECEEF3;

    // Summary badges
    out property <color> indigo-fill: #ECECFC;
    out property <color> indigo-icon: #4A52DD;
    out property <color> green-fill: #DBF2E6;
    out property <color> green-icon: #19A04F;
    out property <color> gray-fill: #E8EBF1;
    out property <color> gray-icon: #3F4A68;

    // Window controls
    out property <color> control-hover: #EBEDF3;
    out property <color> control-pressed: #E0E3EB;
    out property <color> close-hover: #E81123;
    out property <color> close-pressed: #C50F1F;
}
